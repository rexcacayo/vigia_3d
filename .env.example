# Copia como .env la PRIMERA vez (o usa: bash instalar.sh). Nunca lo copies encima de tu .env.

# --- Impresora. PRINTER_TIPO = adaptador en vigia/impresoras/<tipo>.py
PRINTER_TIPO=flashforge
PRINTER_IP=192.168.1.50
# Solo Flashforge: nº de serie y "ID de la impresora" (Ajustes → Red)
PRINTER_SN=SNXXXXXXXXXXX
PRINTER_CHECK_CODE=xxxxxxxx

# --- Claude
ANTHROPIC_API_KEY=sk-ant-...
MODELO_FILTRO=claude-haiku-4-5-20251001
MODELO_DIAGNOSTICO=claude-sonnet-5-5

# --- Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Vigilancia
INTERVALO_S=30
CONFIANZA_MIN=0.6
COOLDOWN_AVISO_S=600
DIAG_CADA=10
INFORME_CADA_MIN=5
ZOOM_REGION=0.15,0.2,0.85,0.9
# El filtro también mira la ampliación (más preciso, ~2x su coste)
FILTRO_CON_ZOOM=true
AUTO_PAUSA=false

# --- Correcciones en marcha: off | proponer | auto
CORRECCION_MODO=proponer
CORRECCION_CONFIANZA=0.8
CORRECCION_MAX=3
CORRECCION_ESPERA_S=300
REVERTIR_TRAS_OK=3

# --- Dónde guardar casos, fotos, log e informes.
# En WSL puedes usar una carpeta de Windows, p. ej. /mnt/c/Users/<tu_usuario>/Documents/vigia
DIR_CASOS=casos
